{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serenay Mobile Deploy",
  "version": "0.2.8",
  "identifier": "com.serenaymobiledeploy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Serenay Mobile Deploy",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["scripts/*"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1NzUzRThCRTBFMjA3MzAKUldRd0IrTGdpejUxdGRTdlZrZW5aUjh4UHFvZmVVaWI4czZDZ0VDTEpiQ3FRdXViOTdVZkYzNUkK",
      "endpoints": [
        "https://github.com/serenayyazilim/serenay-mobile-deploy/releases/latest/download/latest.json"
      ]
    }
  }
}
